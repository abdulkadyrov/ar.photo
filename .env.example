# Browser-safe Supabase configuration. Never place secret/service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PUBLIC_APP_URL=http://localhost:5173/ar.photo/

# Edge-only, non-secret redirect. Configure it in the Supabase function environment, never as VITE_*.
TEAM_INVITE_REDIRECT_URL=http://localhost:5173/ar.photo/settings/team
