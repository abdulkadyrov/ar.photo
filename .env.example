# Browser-safe Supabase configuration. Never place secret/service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PUBLIC_APP_URL=http://localhost:5173/ar.photo/

# Edge-only, non-secret redirect. Configure it in the Supabase function environment, never as VITE_*.
TEAM_INVITE_REDIRECT_URL=http://localhost:5173/ar.photo/settings/team
ADMIN_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/ar.photo/update-password

# Edge-only analytics configuration. Never expose these values through VITE_* variables.
PUBLIC_MANIFEST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_MANIFEST_RATE_LIMIT_SALT=replace-with-a-32-character-manifest-rate-limit-salt
PUBLIC_ANALYTICS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_ANALYTICS_HASH_SALT=replace-with-at-least-32-random-characters
ANALYTICS_CLEANUP_SECRET=replace-with-a-different-32-character-secret
ANALYTICS_RETENTION_DAYS=365

# Edge-only upload maintenance. Configure this value independently from every other secret.
UPLOAD_CLEANUP_SECRET=replace-with-a-different-32-character-upload-secret
