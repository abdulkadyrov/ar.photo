{$AR_PHOTO_HOST} {
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://141-133-204-84.sslip.io; media-src 'self' blob: https://*.supabase.co https://141-133-204-84.sslip.io; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://141-133-204-84.sslip.io; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=15552000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    @api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/* /realtime/v1/*
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }
    handle /healthz {
        respond "AR Photo API gateway" 200
    }
    handle /ar.photo/assets/* {
        root * /srv/ar-photo/current
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /ar.photo/* {
        root * /srv/ar-photo/current
        header Cache-Control "no-cache"
        try_files {path} /ar.photo/index.html
        file_server
    }
    handle / {
        redir * /ar.photo/ 302
    }
    handle {
        respond "Not found" 404
    }
}
